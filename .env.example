# ─── Encryption key for credential envelopes (REQUIRED) ───
# Мастер-ключ, которым шифруются конверты X-Kaspi-Credentials.
# Сгенерировать: openssl rand -hex 32
# ⚠️ Потеря ключа = все мерчанты проходят onboarding заново.
TOKEN_SECRET_KEY=

# Ротация ключа: список через запятую, первый шифрует, все пробуются на
# расшифровке. Конверты под старым ключом продолжают работать, а сервер отдаёт
# перевыпущенный в заголовке X-Kaspi-Credentials-Refresh.
# TOKEN_SECRET_KEYS=<новый_hex>,<старый_hex>

PORT=3000

# Сколько мерчантов опрашивать параллельно (платежи одного — последовательно).
# POLL_CONCURRENCY=5

# Полный дамп HTTP-обмена с Kaspi в stdout. Секретные заголовки редактируются,
# но тела ответов содержат токены — не включайте в проде.
# LOG_HTTP=1

# ─── App version & device constants (optional) ───
# Defaults match a known-good Kaspi Pay client.
# ⚠️ The Kaspi API validates these — use values from a real device cookie.
# APP_VERSION=4.110.1
# APP_BUILD=1099
# APP_PLATFORM=iOS
# APP_PLATFORM_VER=18.5
# APP_LOCALE=ru-RU
# APP_MODEL=iPhone17,3
# APP_BRAND=Apple
# APP_DEVICE_NAME=iPhone
# APP_SCREEN_W=393.0
# APP_SCREEN_H=852.0
# APP_CFNETWORK=CFNetwork/3826.500.131
# APP_DARWIN=Darwin/24.5.0
